# NexaDesk stack configuration.
# Copy this file to .env and fill in the values before starting the stack:
#   cp .env.template .env
# The .env file is git-ignored and must not be committed.

# PostgreSQL
# The service "db" creates its database from these values.
POSTGRES_DB=nexadesk
POSTGRES_USER=nexadesk
POSTGRES_PASSWORD=change_me_postgres_password

# Backend connection to PostgreSQL.
# Keep the credentials in sync with the POSTGRES_* values above.
# The host must stay "db" while the stack runs in Docker Compose.
DATABASE_URL=postgresql+asyncpg://nexadesk:change_me_postgres_password@db:5432/nexadesk

# Redis
# The host must stay "redis" while the stack runs in Docker Compose.
REDIS_URL=redis://redis:6379/0

# JWT
# Secrets must be at least 32 characters and must not start with CHANGE_ME.
# Generate each value with: openssl rand -hex 32
ACCESS_SECRET=
REFRESH_SECRET=

# Token lifetimes in minutes
ACCESS_TOKEN_EXPIRE_M=15
REFRESH_TOKEN_EXPIRE_M=43200

# Cookies
# Keep COOKIE_SECURE=false over plain HTTP, set true behind HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# CORS
# Origins allowed to call the API directly. The web client is same-origin
# behind nginx and needs no CORS of its own.
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:3000","http://127.0.0.1:3000"]

# FastAPI
DEBUG=false

# Realtime (SSE)
SSE_HEARTBEAT_S=15
SSE_IDLE_TIMEOUT_S=300
SSE_MAX_QUEUED_EVENTS=10000
SSE_REPLAY_LIMIT=500

# Published host ports
# Web client: http://localhost:<WEB_PORT>
WEB_PORT=8080
# API and Swagger UI: http://localhost:<API_PORT>/docs
API_PORT=8000
