apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: nexadesk
  labels:
    app.kubernetes.io/name: nexadesk
    app.kubernetes.io/component: secrets
type: Opaque
stringData:
  POSTGRES_PASSWORD: "admin-strong-pass"
  POSTGRES_USER_PASSWORD: "user-strong-pass"
  POSTGRES_REPLICATION_PASSWORD: "repl-strong-pass"
  DB_USER: "nexadesk"
  DB_PASSWORD: "user-strong-pass"

  REDIS_PASSWORD: "redis-strong-pass"

  # App secrets
  DATABASE_URL: "postgresql+asyncpg://nexadesk:user-strong-pass@nexadesk-db-postgresql:5432/nexadesk"
  REDIS_URL: "redis://:redis-strong-pass@nexadesk-redis-master:6379/0"
  
  ACCESS_SECRET: "change_me_access_secret_at_least_32_chars"
  REFRESH_SECRET: "change_me_access_secret_at_least_32_chars"
