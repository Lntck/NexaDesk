environments:
  dev:
  prod:

---

helmDefaults:
  wait: true
  timeout: 300
  atomic: true

repositories:
  - name: bitnami
    url: https://charts.bitnami.com/bitnami

releases:
  - name: nexadesk-db
    namespace: nexadesk
    chart: bitnami/postgresql
    version: 18.12.14
    values:
      - environments/{{ .Environment.Name }}/postgres-values.yaml

  - name: nexadesk-redis
    namespace: nexadesk
    chart: bitnami/redis
    version: 28.3.0
    values:
      - environments/{{ .Environment.Name }}/redis-values.yaml

  - name: nexadesk-app
    namespace: nexadesk
    chart: ./charts/nexadesk-app
    values:
      - environments/{{ .Environment.Name }}/app-values.yaml
    needs:
      - nexadesk/nexadesk-db
      - nexadesk/nexadesk-redis
    timeout: 600
