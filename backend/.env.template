# FastAPI
DEBUG=False

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
ACCESS_SECRET=change_me_access_secret_at_least_32_chars
REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars

# Token lifetime in minutes
ACCESS_TOKEN_EXPIRE_M=15
REFRESH_TOKEN_EXPIRE_M=43200

# Cookies
# set COOKIE_SECURE=false for local development over plain HTTP
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

# Realtime (SSE)
SSE_HEARTBEAT_S=15
SSE_IDLE_TIMEOUT_S=300
SSE_MAX_QUEUED_EVENTS=10000
SSE_REPLAY_LIMIT=500
